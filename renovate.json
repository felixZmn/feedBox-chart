{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":disableDependencyDashboard"
  ],
  "labels": ["dependencies"],
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Chart\\.yaml$/"],
      "matchStrings": [
        "appVersion:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/felixzmn/docker/feedbox",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge patch image updates and bump chart patch version",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/felixzmn/docker/feedbox"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "bumpVersions": [
        {
          "name": "Bump Helm chart version",
          "filePatterns": ["/^Chart\\.yaml$/"],
          "matchStrings": [
            "(?:^|\\n)version:\\s+[\"']?(?<version>\\d+\\.\\d+\\.\\d+)[\"']?"
          ],
          "bumpType": "patch"
        }
      ]
    },
    {
      "description": "Automerge minor image updates and bump chart minor version",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/felixzmn/docker/feedbox"],
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "automergeType": "pr",
      "bumpVersions": [
        {
          "name": "Bump Helm chart version",
          "filePatterns": ["/^Chart\\.yaml$/"],
          "matchStrings": [
            "(?:^|\\n)version:\\s+[\"']?(?<version>\\d+\\.\\d+\\.\\d+)[\"']?"
          ],
          "bumpType": "minor"
        }
      ]
    },
    {
      "description": "Major image updates require a human merge and bump chart major version",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/felixzmn/docker/feedbox"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "bumpVersions": [
        {
          "name": "Bump Helm chart version",
          "filePatterns": ["/^Chart\\.yaml$/"],
          "matchStrings": [
            "(?:^|\\n)version:\\s+[\"']?(?<version>\\d+\\.\\d+\\.\\d+)[\"']?"
          ],
          "bumpType": "major"
        }
      ]
    }
  ],
  "timezone": "Europe/Berlin"
}
